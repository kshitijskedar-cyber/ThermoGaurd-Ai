# ThermoGuard AI - Phase 3C configuration.
# With NO variables set the application runs on the built-in demonstration dataset.
# Copy this file to `.env` (never commit `.env`) and fill in only what you need.

# ---- Option A: key in the browser (simplest; the key is embedded in the built JavaScript) --------------------
# Free NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/area/
# VITE_FIRMS_API_KEY=

# ---- Option B: key kept on the server (recommended if the app is shared or deployed) -------------------------
# Needed when the browser blocks direct FIRMS requests (CORS). The Vite dev/preview server proxies /api/firms to NASA
# and adds FIRMS_MAP_KEY itself. FIRMS_MAP_KEY has no VITE_ prefix, so it never reaches client code.
# FIRMS_MAP_KEY=
# VITE_FIRMS_BASE_URL=/api/firms

# ---- Area of interest (optional) ----------------------------------------------------------------------------------
# west,south,east,north in decimal degrees. Default: Western / Central India (68,15.5,81,25).
# VITE_FIRMS_BBOX=68,15.5,81,25
# VITE_FIRMS_REGION_LABEL=Western / Central India

# ---- FIRMS request (optional) -------------------------------------------------------------------------------------
# VITE_FIRMS_SOURCE=VIIRS_SNPP_NRT   # near-real-time VIIRS (375 m). Other FIRMS sources, e.g. VIIRS_NOAA20_NRT or MODIS_NRT.
# VITE_FIRMS_DAY_RANGE=5             # 1 to 5 days (FIRMS area API limit); also the length of the persistence window

# ---- OpenStreetMap / Overpass (optional) --------------------------------------------------------------------------
# VITE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- Mode (optional) ----------------------------------------------------------------------------------------------
# VITE_DATA_MODE=demo|live   # default: live when a FIRMS key or proxy is configured, otherwise demo
# URL override for a single visit: ?mode=demo or ?mode=live
